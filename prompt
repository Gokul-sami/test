import json
from collections import Counter

# change path to wherever your cleaned file is
PATH = "train.jsonl"  # or whatever the file is called
TEST_PATH = "test.jsonl"

def load(p):
    with open(p) as f:
        return [json.loads(l) for l in f if l.strip()]

train = load(PATH)
test = load(TEST_PATH)

print("train rows:", len(train))
print("test rows:", len(test))

# what files are in each
train_files = Counter(r.get("file_id") or r.get("pair_id") or r.get("file") for r in train)
test_files  = Counter(r.get("file_id") or r.get("pair_id") or r.get("file") for r in test)

print("\ntrain files:")
for k, v in train_files.items():
    print(f"  {k}: {v}")
print("\ntest files:")
for k, v in test_files.items():
    print(f"  {k}: {v}")

# what fields does each row have
print("\nrow keys:", sorted(train[0].keys()))
print("\nfirst row sample:")
for k, v in train[0].items():
    print(f"  {k}: {repr(v)[:120]}")
