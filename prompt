import json
from collections import defaultdict

def load(p):
    with open(p) as f:
        return [json.loads(l) for l in f if l.strip()]

train = load("train.jsonl")
test  = load("test.jsonl")
all_rows = train + test

print(f"total rows: {len(all_rows)}")

# --- Step 0: what keys exist, and how many rows have each?
from collections import Counter
key_counts = Counter()
for r in all_rows:
    for k in r.keys():
        key_counts[k] += 1
print("\nkey presence across all rows:")
for k, v in sorted(key_counts.items()):
    print(f"  {k}: {v}/{len(all_rows)}")

# --- Step 1: PDF text distribution (skip rows without pdf_text)
by_file_pdf = defaultdict(set)
skipped_pdf = 0
for r in all_rows:
    f = r.get("docx_path", "UNKNOWN").split("\\")[-1]
    if "pdf_text" in r and r["pdf_text"] is not None:
        by_file_pdf[f].add(r["pdf_text"])
    else:
        skipped_pdf += 1

print(f"\nrows skipped (no pdf_text): {skipped_pdf}")
print("distinct pdf_text values per file:")
for f, pdfs in sorted(by_file_pdf.items()):
    print(f"  {f}: {len(pdfs)} distinct pdf_texts")
    for s in list(pdfs)[:5]:
        print(f"      {repr(s)[:100]}")

# --- Step 2: docx text distribution (defensive)
by_file_docx = defaultdict(set)
skipped_docx = 0
for r in all_rows:
    f = r.get("docx_path", "UNKNOWN").split("\\")[-1]
    if "docx_text" in r and r["docx_text"] is not None:
        by_file_docx[f].add(r["docx_text"])
    else:
        skipped_docx += 1

print(f"\nrows skipped (no docx_text): {skipped_docx}")
print("distinct docx_text values per file:")
for f, docs in sorted(by_file_docx.items()):
    print(f"  {f}: {len(docs)} distinct docx_texts")
    for s in list(docs)[:3]:
        print(f"      {repr(s)[:100]}")

# --- Step 3: print one full row to see actual shape
print("\n--- sample row 0 full dump ---")
print(json.dumps(all_rows[0], indent=2, default=str)[:2000])
